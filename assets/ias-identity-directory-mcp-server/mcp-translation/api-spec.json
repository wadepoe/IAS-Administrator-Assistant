{
  "openapi": "3.0.3",
  "info": {
    "title": "SAP Identity Authentication Service - Identity Directory (SCIM) API",
    "description": "SCIM 2.0 API for managing users and groups in SAP Cloud Identity Services (IAS). Covers user search, retrieval, password reset, account unlock, and group membership management.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{tenant}.accounts.ondemand.com",
      "variables": {
        "tenant": {
          "description": "Your IAS tenant subdomain",
          "default": "your-tenant"
        }
      }
    }
  ],
  "paths": {
    "/scim/Users": {
      "get": {
        "operationId": "searchUsers",
        "summary": "Search for users",
        "description": "Search for users in the IAS Identity Directory using SCIM filter syntax. Supports filtering by email, display name, user ID, and other attributes.",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "description": "SCIM filter expression, e.g. emails.value eq \"user@example.com\" or displayName co \"John\"",
            "schema": { "type": "string" }
          },
          {
            "name": "count",
            "in": "query",
            "description": "Maximum number of results to return (max 100)",
            "schema": { "type": "integer", "default": 20, "maximum": 100 }
          },
          {
            "name": "startIndex",
            "in": "query",
            "description": "1-based index for pagination",
            "schema": { "type": "integer", "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "List of matching users",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserListResponse" }
              }
            }
          },
          "400": { "description": "Bad request - invalid filter syntax" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden - insufficient API scope" }
        }
      }
    },
    "/scim/Users/{userId}": {
      "get": {
        "operationId": "getUser",
        "summary": "Get user by ID",
        "description": "Retrieve full details for a specific user including status, group memberships, and all attributes.",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "The IAS SCIM user ID",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "User details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "404": { "description": "User not found" }
        }
      },
      "patch": {
        "operationId": "updateUser",
        "summary": "Update user attributes",
        "description": "Partially update a user. Used to unlock accounts (set active=true) and update other attributes.",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserPatchRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          }
        }
      }
    },
    "/service/users/{userId}/passwordReset": {
      "post": {
        "operationId": "resetUserPassword",
        "summary": "Reset user password",
        "description": "Trigger a password reset for a specific user. Sends a reset email or resets to a new temporary password depending on tenant configuration.",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "The IAS user ID",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sendEmail": {
                    "type": "boolean",
                    "description": "Send password reset email to user",
                    "default": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Password reset triggered successfully" },
          "404": { "description": "User not found" }
        }
      }
    },
    "/scim/Groups": {
      "get": {
        "operationId": "searchGroups",
        "summary": "Search for groups",
        "description": "Search for groups in IAS. Supports SCIM filter syntax e.g. displayName eq \"Admins\".",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "count",
            "in": "query",
            "schema": { "type": "integer", "default": 20, "maximum": 100 }
          }
        ],
        "responses": {
          "200": {
            "description": "List of matching groups",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GroupListResponse" }
              }
            }
          }
        }
      }
    },
    "/scim/Groups/{groupId}": {
      "patch": {
        "operationId": "updateGroupMembers",
        "summary": "Add or remove group members",
        "description": "Update group membership by adding or removing members using SCIM PATCH with operations.",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GroupPatchRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Group membership updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Group" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "IAS SCIM user ID" },
          "userName": { "type": "string" },
          "displayName": { "type": "string" },
          "active": { "type": "boolean", "description": "Whether the account is active (false = locked/disabled)" },
          "emails": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": { "type": "string" },
                "primary": { "type": "boolean" }
              }
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": { "type": "string", "description": "Group ID" },
                "display": { "type": "string", "description": "Group display name" }
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["active", "inactive", "initial"] }
            }
          }
        }
      },
      "UserListResponse": {
        "type": "object",
        "properties": {
          "totalResults": { "type": "integer" },
          "Resources": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/User" }
          }
        }
      },
      "UserPatchRequest": {
        "type": "object",
        "properties": {
          "schemas": {
            "type": "array",
            "items": { "type": "string" },
            "default": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"]
          },
          "Operations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "op": { "type": "string", "enum": ["replace", "add", "remove"] },
                "path": { "type": "string" },
                "value": {}
              }
            }
          }
        }
      },
      "Group": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "displayName": { "type": "string" },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": { "type": "string", "description": "User ID" },
                "display": { "type": "string" }
              }
            }
          }
        }
      },
      "GroupListResponse": {
        "type": "object",
        "properties": {
          "totalResults": { "type": "integer" },
          "Resources": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Group" }
          }
        }
      },
      "GroupPatchRequest": {
        "type": "object",
        "properties": {
          "schemas": {
            "type": "array",
            "items": { "type": "string" },
            "default": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"]
          },
          "Operations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "op": { "type": "string", "enum": ["add", "remove"] },
                "path": { "type": "string", "example": "members" },
                "value": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": { "type": "string", "description": "User ID" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://{tenant}.accounts.ondemand.com/oauth2/token",
            "scopes": {
              "ias.user.read": "Read user data",
              "ias.user.write": "Write user data (reset, unlock, group assignment)"
            }
          }
        }
      }
    }
  },
  "security": [{ "oauth2": [] }]
}
